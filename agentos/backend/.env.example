# Backend Environment Variables — copy to .env and fill in real values

# Database
DATABASE_URL=postgresql://agentos:agentos_secret@localhost:5432/agentos

# PayPal Sandbox credentials (create at https://developer.paypal.com)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Your app's public URL (used for PayPal return/cancel URLs)
APP_BASE_URL=http://localhost:5173

# LLM provider — set to "stub" for local dev without a real key
LLM_PROVIDER=stub
LLM_MODEL=stub-v1
# LLM_API_KEY=your_key_here  # needed when LLM_PROVIDER != stub

# PayGuard limits
MAX_TXN_MINOR=1000000   # 10 000.00 USD in cents

# CORS origins (space-separated)
CORS_ORIGINS=http://localhost:5173
