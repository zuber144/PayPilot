# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./agentos.db
# DATABASE_URL=postgresql+psycopg://agentos:agentos@localhost:5432/agentos
FRONTEND_URL=http://localhost:5173

# mock | live   (live falls back to mock if the selected provider has no key)
LLM_MODE=mock
# anthropic | openai
LLM_PROVIDER=anthropic
# Leave blank to use ANTHROPIC_API_KEY from your shell environment.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# mock | sandbox
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYMENTS_ENABLED=true


# Optional overrides (defaults in app/config.py). Business-rule limits such as
# MAX_TXN_MINOR, risk thresholds and loop bounds are intentionally not listed here.
# LLM_TIMEOUT_SECONDS=20
# LLM_RETRIES=1
# ANTHROPIC_MAX_TOKENS=4096
# PAYPAL_TIMEOUT_SECONDS=20

# Sandbox notes: PayPal Sandbox rejects INR, so the demo is USD-only. Use US business and
# US personal Sandbox accounts. CORS allows FRONTEND_URL plus localhost/127.0.0.1:5173.
